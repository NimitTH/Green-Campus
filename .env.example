# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Origin used in signup/reset email links. Locally always http://localhost:3000;
# on Vercel set it to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never expose to the browser.
SUPABASE_SECRET_KEY=your-secret-key
# Server only. Bearer token Vercel Cron sends to /api/cron/cleanup-orphans (set the same value in Vercel env).
# Generate with: openssl rand -hex 32
#   or: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value.
CRON_SECRET=

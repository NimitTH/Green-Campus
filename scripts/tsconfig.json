{
  // Type-check of the Node scripts (run directly by Node with type stripping: explicit .ts imports, no
  // aliases, erasable syntax only). Not part of `next build` (the root tsconfig excludes scripts/).
  //   npx tsc -p scripts/tsconfig.json
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": ["**/*.ts"]
}
